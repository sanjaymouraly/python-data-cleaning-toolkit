# The toolkit is fully offline and needs no credentials or API keys.
#
# Optional runtime overrides (all have safe defaults):

# Cap dashboard upload size in MB (independent of per-config limits)
# DTK_MAX_UPLOAD_MB=200

# Local workspace directory for dashboard uploads/runs/profiles
# (default: ./dtk_workspace)
# DTK_WORKSPACE=/var/lib/data-cleaner

# Base URL used by the screenshot/browser tooling
# DTK_BASE_URL=http://localhost:8501
